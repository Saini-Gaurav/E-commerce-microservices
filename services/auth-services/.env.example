API_URl = api/v1
PORT=4001
NODE_ENV=development

PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=auth_service_db

PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=5000

# Auth
# RS256 asymmetric signing: auth-service holds the PRIVATE key (signs
# tokens); every OTHER service that needs to verify these tokens only
# ever gets the PUBLIC key (keys/public.pem — safe to copy elsewhere,
# it cannot be used to forge a token). Paths are relative to this
# service's root folder. Generate your own pair locally — see README.
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_MS=604800000