PORT=4002
NODE_ENV=development

API_URL=/api/v1

PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=product_service_db

PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=5000

# Only the PUBLIC key - this service verifies tokens, never signs them.
# Copy public.pem from auth-service's keys/ folder; never copy private.pem.
JWT_PUBLIC_KEY_PATH=./keys/public.pem

CORS_ORIGIN=http://localhost:3000

KAFKA_BROKERS=localhost:3344