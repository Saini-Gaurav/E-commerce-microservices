PORT=4002
NODE_ENV=development

API_URL=/api/v1

PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=product_service_db

PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=5000

# Must be the EXACT same value as auth-service's JWT_ACCESS_SECRET.
# This is what lets product-service verify a token it never issued -
# both services are validating the same signature with the same key.
JWT_ACCESS_SECRET=replace_with_a_long_random_string

CORS_ORIGIN=http://localhost:3000