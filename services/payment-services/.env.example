PORT=4005
NODE_ENV=development

API_URL=/api/v1

PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=payment_service_db

PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=5000

JWT_PUBLIC_KEY_PATH=./keys/public.pem

KAFKA_BROKERS=localhost:9092

# Sandbox/test keys from your Razorpay dashboard (Settings > API Keys,
# make sure "Test Mode" is toggled on). Test keys always start with
# rzp_test_ - never paste a rzp_live_ key into a learning project.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_secret_here

CORS_ORIGIN=http://localhost:3000