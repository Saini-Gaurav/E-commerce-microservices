PORT=4003
NODE_ENV=development

API_URL=/api/v1

PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=cart_service_db

PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=5000

JWT_PUBLIC_KEY_PATH=./keys/public.pem

# Base URL cart-service uses to enrich cart items with live product data.
# In Docker Compose this becomes the service name (http://product-service:4002/api/v1)
# instead of localhost - same idea as PGHOST being overridden per-environment.
PRODUCT_SERVICE_URL=http://localhost:4002/api/v1

CORS_ORIGIN=http://localhost:3000